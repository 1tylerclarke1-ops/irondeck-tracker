{
  "name": "DecayEvent",
  "type": "object",
  "properties": {
    "step": {
      "type": "string",
      "enum": [
        "spinning",
        "rarity",
        "rolling",
        "reveal",
        "done"
      ],
      "default": "spinning",
      "description": "Current phase of the decay event shown on the overlay"
    },
    "wheel_card_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Card names shown as wheel slices"
    },
    "wheel_card_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Scryfall ids for the wheel cards, parallel to wheel_card_names"
    },
    "chosen_card": {
      "type": "string",
      "description": "Card the wheel landed on (the card that will decay)"
    },
    "card_removed": {
      "type": "string",
      "description": "Card removed from the deck"
    },
    "card_removed_id": {
      "type": "string",
      "description": "Scryfall id of the card removed from the deck"
    },
    "replacement_card": {
      "type": "string",
      "description": "Card added as the decay replacement"
    },
    "replacement_card_id": {
      "type": "string",
      "description": "Scryfall id of the replacement card"
    },
    "rarity_roll": {
      "type": "string",
      "enum": [
        "uncommon",
        "common",
        "basic"
      ],
      "description": "The 50/50 rarity roll used for the replacement"
    },
    "roll_cards": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "image_url": {
            "type": "string"
          }
        }
      },
      "description": "Cards shown during the rolling animation; the replacement is last"
    },
    "zone": {
      "type": "string",
      "enum": [
        "main",
        "sideboard"
      ],
      "default": "main",
      "description": "Deck zone the replacement went into"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the event was last updated"
    }
  },
  "required": [
    "step"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}