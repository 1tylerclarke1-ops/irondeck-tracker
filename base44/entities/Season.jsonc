{
  "name": "Season",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Season name"
    },
    "colours": {
      "type": "string",
      "description": "Deck colour identity, e.g. WB, UBR"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "ended"
      ],
      "default": "active"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Season start date"
    },
    "season_number": {
      "type": "integer",
      "description": "Season number"
    },
    "condemned_card": {
      "type": "string",
      "description": "Card currently condemned by the season's block rules"
    },
    "condemned_since": {
      "type": "string",
      "format": "date-time",
      "description": "When the current card was condemned"
    },
    "block_days": {
      "type": "integer",
      "default": 0,
      "description": "Days the condemned card has been blocked so far"
    },
    "block_sentence": {
      "type": "integer",
      "default": 3,
      "description": "Block sentence length in days for a condemned card"
    },
    "block_capture": {
      "type": "integer",
      "default": 1,
      "description": "How many block captures have been served"
    },
    "pardon_counts": {
      "type": "string",
      "description": "JSON text tracking per-card pardon counts"
    },
    "last_pardoned": {
      "type": "string",
      "description": "Card most recently pardoned from a block"
    }
  },
  "required": [
    "name",
    "colours"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}