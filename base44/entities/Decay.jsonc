{
  "name": "Decay",
  "type": "object",
  "properties": {
    "season_id": {
      "type": "string",
      "description": "Season this decay belongs to"
    },
    "run_id": {
      "type": "string",
      "description": "Run this decay belongs to"
    },
    "attempt_number": {
      "type": "integer",
      "description": "Attempt number that triggered this decay"
    },
    "card_removed": {
      "type": "string",
      "description": "Name of the card removed"
    },
    "rarity_from": {
      "type": "string",
      "enum": [
        "mythic",
        "rare",
        "uncommon",
        "common",
        "basic"
      ],
      "description": "Rarity of the removed card"
    },
    "rarity_to": {
      "type": "string",
      "enum": [
        "mythic",
        "rare",
        "uncommon",
        "common",
        "basic"
      ],
      "description": "Rarity of the replacement card"
    },
    "replacement_card": {
      "type": "string",
      "description": "Name of the replacement card"
    },
    "how_obtained": {
      "type": "string",
      "enum": [
        "owned",
        "wildcard",
        "reroll",
        "pending"
      ],
      "description": "How the replacement was obtained"
    },
    "zone": {
      "type": "string",
      "enum": [
        "main",
        "sideboard"
      ],
      "default": "main",
      "description": "Deck zone the replacement card went into"
    },
    "sideboard_rotted": {
      "type": "boolean",
      "default": false,
      "description": "Whether this decay caused the sideboard to rot to zero copies"
    },
    "date": {
      "type": "string",
      "format": "date-time",
      "description": "When the decay occurred"
    }
  },
  "required": [
    "season_id",
    "card_removed",
    "rarity_from",
    "rarity_to",
    "replacement_card",
    "how_obtained"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}