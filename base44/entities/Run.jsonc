{
  "name": "Run",
  "type": "object",
  "properties": {
    "season_id": {
      "type": "string",
      "description": "Season this run belongs to"
    },
    "attempt_number": {
      "type": "integer",
      "description": "Attempt number within the season"
    },
    "wins": {
      "type": "integer",
      "default": 0,
      "description": "Wins in this run"
    },
    "losses": {
      "type": "integer",
      "default": 0,
      "description": "Losses in this run"
    },
    "result": {
      "type": "string",
      "enum": [
        "in_progress",
        "cleared",
        "died"
      ],
      "default": "in_progress",
      "description": "Run outcome"
    },
    "stage": {
      "type": "integer",
      "default": 1,
      "description": "Current stage number"
    },
    "stage_wins": {
      "type": "integer",
      "default": 0,
      "description": "Wins in the current stage"
    },
    "stage_losses": {
      "type": "integer",
      "default": 0,
      "description": "Losses in the current stage"
    },
    "total_wins": {
      "type": "integer",
      "default": 0,
      "description": "Total wins across all stages"
    },
    "stage_cleared_pending": {
      "type": "boolean",
      "default": false,
      "description": "Stage hit 7 wins and is awaiting continue to the next stage"
    },
    "round_wins": {
      "type": "integer",
      "default": 0,
      "description": "Wins in the current round"
    },
    "round_losses": {
      "type": "integer",
      "default": 0,
      "description": "Losses in the current round"
    },
    "round_status": {
      "type": "string",
      "enum": [
        "playing",
        "survived",
        "died"
      ],
      "default": "playing",
      "description": "Status of the current round"
    }
  },
  "required": [
    "season_id",
    "attempt_number"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}