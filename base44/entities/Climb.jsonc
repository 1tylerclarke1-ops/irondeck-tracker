{
  "name": "Climb",
  "type": "object",
  "properties": {
    "number": {
      "type": "integer",
      "description": "Climb number"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Climb start date"
    },
    "mythic_date": {
      "type": "string",
      "format": "date",
      "description": "Date mythic rank was reached"
    },
    "days_taken": {
      "type": "integer",
      "description": "Days taken to reach mythic"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "complete"
      ],
      "default": "active",
      "description": "Climb status"
    }
  },
  "required": [
    "number"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}