{
  "name": "Card",
  "type": "object",
  "properties": {
    "season_id": {
      "type": "string",
      "description": "Season this card belongs to"
    },
    "name": {
      "type": "string",
      "description": "Card name"
    },
    "copies": {
      "type": "integer",
      "description": "Number of copies in the deck"
    },
    "original_copies": {
      "type": "integer",
      "default": 0,
      "description": "Copies when the card was first added to the deck"
    },
    "rarity": {
      "type": "string",
      "enum": [
        "mythic",
        "rare",
        "uncommon",
        "common",
        "basic"
      ],
      "description": "Card rarity"
    },
    "card_type": {
      "type": "string",
      "enum": [
        "creature",
        "instant",
        "sorcery",
        "enchantment",
        "artifact",
        "planeswalker",
        "land",
        "battle"
      ],
      "description": "Card type"
    },
    "zone": {
      "type": "string",
      "enum": [
        "main",
        "sideboard"
      ],
      "default": "main",
      "description": "Deck zone"
    },
    "mana_cost": {
      "type": "string",
      "description": "Mana cost, e.g. {2}{B}{G}",
      "default": ""
    },
    "colours": {
      "type": "string",
      "description": "Card colour identity, e.g. BG",
      "default": ""
    },
    "mana_value": {
      "type": "number",
      "description": "Mana value (converted mana cost)"
    },
    "is_decay_replacement": {
      "type": "boolean",
      "default": false,
      "description": "Whether this card entered the deck as a decay replacement"
    },
    "decayed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this card was added as a decay replacement"
    }
  },
  "required": [
    "season_id",
    "name",
    "copies",
    "rarity",
    "card_type"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}